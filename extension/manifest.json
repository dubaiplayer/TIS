{
  "manifest_version": 3,
  "name": "Phishing Analyzer — Inbox Shield",
  "description": "Phishing safety check inside Gmail. Analyzes each email you open and shows an inline verdict with the reasons behind it.",
  "version": "1.0.0",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inbox Shield settings",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://phishing-analyzer-api-wq1v.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["banner.css"],
      "run_at": "document_idle"
    }
  ]
}
